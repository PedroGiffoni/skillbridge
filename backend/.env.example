# Somente backend. Não cole esta chave no chat ou em variáveis VITE_*.
GEMINI_API_KEY=
GEMINI_MODEL=
# Ative somente após confirmar modelo e cota gratuita no projeto AI Studio.
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_REQUESTS_PER_MINUTE=5
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Login. Use segredo aleatório com ao menos 32 caracteres.
AUTH_OTP_SECRET=
# Padrão backend/data/skillbridge.sqlite3. Configure caminho persistente na hospedagem.
# AUTH_DB_PATH=
AUTH_COOKIE_SECURE=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
AUTH_SMTP_SSL=false
